# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# macOS
.DS_Store

# Per-map configs (GCPs, check points, raster paths) -- don't commit
# map data, keep only the blank template.
configs/*.R
!configs/_template.R

# Input/output data -- keep only README.md in each dir.
inputs/**
!inputs/**/
!inputs/README.md
outputs/**
!outputs/**/
!outputs/README.md
